rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPublished() {
      return resource.data.status == 'published'
        || resource.data.status == 'Published';
    }

    // Projects: public read published only, authenticated admin has full access
    match /projects/{projectId} {
      allow read: if isPublished() || isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Properties: public read, authenticated write
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Blogs: public read published only, authenticated full access
    match /blogs/{blogId} {
      allow read: if isPublished() || isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Media: public read published only, authenticated full access
    match /media/{mediaId} {
      allow read: if isPublished() || isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Requests: anyone can create, authenticated read/write
    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'message'])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.message.size() > 0;

      allow read, update, delete: if isSignedIn();
    }

    // Team Members: public read, authenticated write
    match /team/{memberId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Newsletter: anyone can subscribe, authenticated read/delete
    match /newsletter_subscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*');

      allow read, delete: if isSignedIn();
      allow update: if false;
    }

    // Analytics Visits: anyone can create (log visit)
    match /analytics_visits/{visitId} {
      allow create: if request.resource.data.keys().hasAll(['path', 'sessionId'])
        && request.resource.data.path is string
        && request.resource.data.sessionId is string;

      allow read, delete: if isSignedIn();
      allow update: if false;
    }

    // Analytics Aggregates: public can increment, admin can read
    match /analytics_stats/{statId} {
      allow create, update: if statId == 'page_views'
        || statId.matches('visitors_.*');

      allow read, delete: if isSignedIn();
    }
  }
}
